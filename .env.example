# Host ports published by docker-compose (container ports are fixed)
POSTGRES_PORT=5432
REDIS_PORT=6379

# App
PORT=3000
DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger
REDIS_URL=redis://localhost:6379
DEFAULT_PROVIDER=simulated

# Money rules
PLATFORM_FEE_BPS=1000
PAYOUT_HOLD_DAYS=2
PAYOUT_RESERVE_MINOR=500
PAYOUT_MIN_MINOR=100
PAYOUT_MAX_ATTEMPTS=3
PAYOUT_RETRY_BACKOFF_MS=60000
# Set to false to disable the daily payout / nightly reconciliation schedulers
SCHEDULERS_ENABLED=true

# Webhooks
SIMULATED_WEBHOOK_SECRET=whsec_simulated_dev
WEBHOOK_TOLERANCE_SECONDS=300
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_MS=1000

# Optional real providers (not needed to run)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RazorpayX account number, required for payouts
RAZORPAY_X_ACCOUNT_NUMBER=

# Operations
# Deadline for one Stripe/Razorpay HTTP call (connection + body); a timeout returns 504 and rolls back
PROVIDER_TIMEOUT_MS=15000
# Per-dependency deadline for /health/ready
HEALTH_CHECK_TIMEOUT_MS=2000
# Alerts are always logged; set this to also POST them as JSON (e.g. a Slack incoming webhook)
ALERT_WEBHOOK_URL=
ALERT_TIMEOUT_MS=5000
# Alert when this many webhook events are dead-lettered (0 disables)
ALERT_DLQ_THRESHOLD=1
# Cron (UTC) for the DLQ-depth / ledger-drift monitor
MONITOR_CRON="*/15 * * * *"

# Authentication: "<key>:<role>,<key>:<role>" with role client|admin and keys of 16+ chars.
# Leave empty to run without auth (local dev only; the app warns). NODE_ENV=production requires keys.
API_KEYS=
# Production escape hatch for a deliberately open API (e.g. behind a trusted gateway)
ALLOW_UNAUTHENTICATED=false

# Payout sweeper
PAYOUT_STALE_MS=1800000
PAYOUT_AWAITING_PROVIDER_MS=86400000
PAYOUT_SWEEP_CRON="*/10 * * * *"

# Edge protection
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT=256kb
# Reverse-proxy hops to trust for the client IP (leave unset when not behind a proxy)
TRUST_PROXY=

# Retention (daily purge of old idempotency keys and processed webhook events)
IDEMPOTENCY_KEY_TTL_HOURS=168
WEBHOOK_RETENTION_DAYS=30
MAINTENANCE_CRON="0 4 * * *"

