# Copy to deploy/prod.env (git-ignored) and fill in real values.
POSTGRES_PASSWORD=change-me-long-random
REDIS_PASSWORD=change-me-long-random
# "<key>:<role>,<key>:<role>", keys of 16+ chars, roles client|admin
API_KEYS=
# Number of reverse-proxy hops in front of the API (so rate limits use the real client IP)
TRUST_PROXY=1
ALERT_WEBHOOK_URL=
# Distributed tracing, off while empty. e.g. http://otel-collector:4318 and parentbased_traceidratio / 0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=
OTEL_TRACES_SAMPLER_ARG=
DEFAULT_PROVIDER=simulated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_X_ACCOUNT_NUMBER=
IMAGE_TAG=latest
API_PORT=3000
